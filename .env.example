# OpenAI
OPENAI_API_KEY=

# LangSmith (Observability)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=material-submittal-reviewer

# ChromaDB Cloud
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# Cohere (Reranking)
COHERE_API_KEY=

# Database (Phase 1/3) — DATABASE_URL is the API's RLS-constrained role (api_app).
# WORKER_DATABASE_URL (worker_app, BYPASSRLS) and ADMIN_DATABASE_URL (postgres, migrations
# only) have safe code defaults — only set them here if they need to diverge from local Docker.
DATABASE_URL=postgresql+asyncpg://api_app:api_app_dev_password@localhost:5432/material_submittal_reviewer

# S3 (Phase 2) — dev/prod use different buckets, same region
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=me-central-1
S3_BUCKET_NAME=

# Cognito (Phase 3)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# SQS job queue (Phase 1) — same region as AWS_REGION above. DLQ isn't referenced here;
# AWS routes to it automatically per the redrive policy set on the queue itself.
SQS_QUEUE_URL=

# Qdrant (Phase 4) — self-hosted via docker-compose locally; same image on EC2 in prod.
QDRANT_URL=http://localhost:6333
